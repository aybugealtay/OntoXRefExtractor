    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Object Properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://dl-learner.org/mutagenesis#hasAtom -->

    <owl:ObjectProperty rdf:about="http://dl-learner.org/mutagenesis#hasAtom">
        <rdfs:domain rdf:resource="http://dl-learner.org/mutagenesis#Compound"/>
        <rdfs:range rdf:resource="http://dl-learner.org/mutagenesis#Atom"/>
    </owl:ObjectProperty>
    


    <!-- http://dl-learner.org/mutagenesis#hasBond -->

    <owl:ObjectProperty rdf:about="http://dl-learner.org/mutagenesis#hasBond">
        <rdfs:domain rdf:resource="http://dl-learner.org/mutagenesis#Compound"/>
        <rdfs:range rdf:resource="http://dl-learner.org/mutagenesis#Bond"/>
    </owl:ObjectProperty>
    


    <!-- http://dl-learner.org/mutagenesis#hasStructure -->

    <owl:ObjectProperty rdf:about="http://dl-learner.org/mutagenesis#hasStructure">
        <rdfs:domain rdf:resource="http://dl-learner.org/mutagenesis#Compound"/>
    </owl:ObjectProperty>
    


    <!-- http://dl-learner.org/mutagenesis#inBond -->

    <owl:ObjectProperty rdf:about="http://dl-learner.org/mutagenesis#inBond">
        <rdfs:domain rdf:resource="http://dl-learner.org/mutagenesis#Bond"/>
        <rdfs:range rdf:resource="http://dl-learner.org/mutagenesis#Atom"/>
    </owl:ObjectProperty>
    


    <!-- http://dl-learner.org/mutagenesis#inStructure -->

    <owl:ObjectProperty rdf:about="http://dl-learner.org/mutagenesis#inStructure">
        <rdfs:range rdf:resource="http://dl-learner.org/mutagenesis#RingStructure"/>
    </owl:ObjectProperty>
    


