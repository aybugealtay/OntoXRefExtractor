    <!-- http://dl-learner.org/ont/ACenter -->

    <Class rdf:about="http://dl-learner.org/ont/ACenter">
        <rdfs:subClassOf rdf:resource="http://dl-learner.org/ont/ReactingCenterStatus"/>
        <disjointWith rdf:resource="http://dl-learner.org/ont/NotACenter"/>
    </Class>
    


    <!-- http://dl-learner.org/ont/AromaticBond -->

    <Class rdf:about="http://dl-learner.org/ont/AromaticBond">
        <rdfs:subClassOf rdf:resource="http://dl-learner.org/ont/Bond"/>
        <rdfs:subClassOf rdf:resource="http://dl-learner.org/ont/DoubleOrAromaticBond"/>
        <rdfs:subClassOf rdf:resource="http://dl-learner.org/ont/SingleOrAromaticBond"/>
    </Class>
    


