# Exclude virtual environments
.venv/
hpo_venv/

# Exclude specific file
requirements_owlpy.txt

# Exclude pytest cache
.pytest_cache/

# Exclude Jupyter notebooks except within "notebooks/final"
notebooks/*.ipynb
!notebooks/final/*.ipynb

# Exclude '__pycache__' folders
**/__pycache__/

# Exclude commonly ignored files
.DS_Store
Thumbs.db
*.log
*.pyc
*.pyo

# Ignore downloaded data files
data/uberon.owl
data/cl.owl
data/hp.owl
data/graph.xml